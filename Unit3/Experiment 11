#include<iostream>
using namespace std;

class PersonalDetails
{
public:
    string name;

    void getPersonal()
    {
        cout << "Enter name: ";
        cin >> name;
    }
};

class SalaryDetails
{
public:
    float salary;

    void getSalary()
    {
        cout << "Enter salary: ";
        cin >> salary;
    }
};

class Employee : public PersonalDetails, public SalaryDetails
{
public:
    void display()
    {
        cout << "\nEmployee Details";
        cout << "\nName: " << name;
        cout << "\nSalary: " << salary;
    }
};

class Shape
{
public:
    void show()
    {
        cout << "\nShape Details";
    }
};

class Circle : public Shape
{
public:
    void area()
    {
        float r = 5;
        cout << "\nArea of Circle: " << 3.14 * r * r;
    }
};

class Rectangle : public Shape
{
public:
    void area()
    {
        int l = 5, b = 4;
        cout << "\nArea of Rectangle: " << l * b;
    }
};

int main()
{
    Employee e;
    e.getPersonal();
    e.getSalary();
    e.display();

    Circle c;
    c.show();
    c.area();

    Rectangle r;
    r.show();
    r.area();

    return 0;
}
