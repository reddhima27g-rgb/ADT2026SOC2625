#include<iostream>
using namespace std;

class Calculator
{
public:
    int add(int a, int b)
    {
        return a + b;
    }

    float add(float a, float b)
    {
        return a + b;
    }

    int multiply(int a, int b)
    {
        return a * b;
    }
};

class Distance
{
public:
    int meter;

    Distance(int m = 0)
    {
        meter = m;
    }

    Distance operator+(Distance d)
    {
        Distance temp;
        temp.meter = meter + d.meter;
        return temp;
    }

    void display()
    {
        cout << meter << " meters";
    }
};

int main()
{
    Calculator c;

    cout << "Addition of integers: " << c.add(10, 20);
    cout << "\nAddition of floats: " << c.add(5.5f, 2.5f);
    cout << "\nMultiplication: " << c.multiply(4, 5);

    Distance d1(10), d2(20), d3;

    d3 = d1 + d2;

    cout << "\nTotal Distance: ";
    d3.display();

    return 0;
}
