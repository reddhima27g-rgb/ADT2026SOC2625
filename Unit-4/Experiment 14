#include<iostream>
using namespace std;

class Shape
{
public:
    virtual void area()
    {
        cout << "Area of Shape";
    }
};

class Circle : public Shape
{
public:
    void area()
    {
        float r = 5;
        cout << "Area of Circle: " << 3.14 * r * r;
    }
};

class Square : public Shape
{
public:
    void area()
    {
        int side = 4;
        cout << "\nArea of Square: " << side * side;
    }
};

int main()
{
    Shape *ptr;

    Circle c;
    Square s;

    ptr = &c;
    ptr->area();

    ptr = &s;
    ptr->area();

    return 0;
}
